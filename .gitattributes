# Line endings (SnippStudio phase 10a, S10): text is stored and checked out
# with LF on every system; PowerShell scripts keep CRLF; binaries are never
# converted.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.onnx binary
*.mp4 binary
*.mov binary
*.webm binary
*.wav binary
*.mp3 binary
*.m4a binary
*.flac binary
*.zip binary
*.exe binary
*.dll binary
*.node binary
*.pack binary
*.bin binary
